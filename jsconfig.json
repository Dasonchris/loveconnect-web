{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": [
    "client/**/*",
    "server/**/*",
    "api.js",
    "package.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/node_modules/*"
  ]
}
